{
  "name": "herrku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "mcp"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm -w @herrku/server run dev",
    "dev:web": "npm -w @herrku/web run dev",
    "build": "npm -w @herrku/shared run build && npm -w @herrku/mcp run build && npm -w @herrku/server run build && npm -w @herrku/web run build",
    "start": "node server/dist/index.js",
    "typecheck": "npm -w @herrku/shared run build && tsc --noEmit -p server && tsc --noEmit -p web && tsc --noEmit -p mcp",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "migrate": "tsx server/src/cli/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:e2e": "tsx scripts/seed.ts --e2e",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "audit:tdd": "node scripts/tdd-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.2.0": true
  }
}
